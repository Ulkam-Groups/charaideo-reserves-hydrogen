# Public storefront credentials (safe to use only in server runtime, never commit actual values)
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_CHAT_SHOP=charaideoreserves.myshopify.com
PUBLIC_CHECKOUT_DOMAIN=checkout.your-store.com
# Defaults to fastrr when omitted. Set razorpay only after completing its dashboard setup.
CHECKOUT_PROVIDER=fastrr
PUBLIC_FASTRR_SELLER_DOMAIN=your-configured-seller-domain.com
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-dedicated-webhook-secret
RAZORPAY_BUSINESS_NAME=Charaideo Reserves
RAZORPAY_SHIPPING_FEE_PAISE=0
RAZORPAY_COD_ENABLED=false
RAZORPAY_COD_FEE_PAISE=0
SENTRY_DSN=https://public-key@your-project.ingest.sentry.io/project-id
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=preview
PUBLIC_STOREFRONT_API_TOKEN=abcdefghijklmnopqrstuvwxyz123456
PRIVATE_STOREFRONT_API_TOKEN=shpat_xxx
PUBLIC_STOREFRONT_ID=xxx
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=xxx
PUBLIC_CUSTOMER_ACCOUNT_API_URL=https://shopify.com/authentication
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Server-only Admin API credentials for the Chapter I waitlist.
WRIT_TO_CUSTOMER_CLIENT_ID=your-dev-dashboard-client-id
WRIT_TO_CUSTOMER_CLIENT_SECRET=your-dev-dashboard-client-secret

# Server-only Admin API credentials used to create reconciled Razorpay orders.
# The app installation must grant read_orders and write_orders.
SHOPIFY_ADMIN_CLIENT_ID=your-order-app-client-id
SHOPIFY_ADMIN_CLIENT_SECRET=your-order-app-client-secret

# Retained temporarily so already-in-flight webhook deliveries can be verified.
SHOPIFY_WEBHOOK_SECRET=your-custom-app-api-secret
JUDGEME_SHOP_DOMAIN=f5a7fq-re.myshopify.com
JUDGEME_PUBLIC_API_TOKEN=your-public-token
JUDGEME_PRIVATE_API_TOKEN=your-new-rotated-private-token

# Server-only Shiprocket API user credentials and shipment defaults.
# Optional: paste a generated bearer token to bypass email/password authentication.
# Shiprocket currently documents a 10-day token lifetime, so rotate this value regularly.
SHIPROCKET_API_TOKEN=
SHIPROCKET_API_EMAIL=your-api-user-email
SHIPROCKET_API_PASSWORD=your-api-user-password
SHIPROCKET_PICKUP_PINCODE=your-warehouse-pincode
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
