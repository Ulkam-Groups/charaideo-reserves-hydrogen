# Public storefront credentials (safe to use only in server runtime, never commit actual values)
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=shpat_xxx
PRIVATE_STOREFRONT_API_TOKEN=shpat_xxx
PUBLIC_STOREFRONT_ID=xxx
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=xxx
PUBLIC_CUSTOMER_ACCOUNT_API_URL=https://shopify.com/authentication
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Custom app token: server routes only. Never prefix this with PUBLIC_.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
SHOPIFY_ADMIN_API_VERSION=2026-04
SHOPIFY_LOCATION_ID=gid://shopify/Location/123456789
SHOPIFY_WEBHOOK_SECRET=your-custom-app-api-secret
ADMIN_INTERNAL_TOKEN=long-random-token-for-a-staff-only-admin-ui

# Variant that represents one packed Custom Tea Box. Used for regular cart display only.
CUSTOM_BOX_VARIANT_ID=gid://shopify/ProductVariant/123456789
