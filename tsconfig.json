{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {"~/*": ["app/*"]},
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "typeRoots": ["./app/types", "./node_modules/@types"]
  }
}
