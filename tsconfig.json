{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true, "baseUrl": ".",
    "paths": {"~/*": ["app/*"]}, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "types": ["node", "vite/client"]
  }
}
