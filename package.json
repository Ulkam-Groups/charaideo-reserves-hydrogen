{
  "name": "assam-tea-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run typegen && shopify hydrogen dev",
    "dev:local": "vite --host 0.0.0.0",
    "build": "npm run typegen && vite build",
    "start": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typegen": "react-router typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "deploy:oxygen": "npm run typegen && shopify hydrogen deploy",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@shopify/hydrogen": "^2026.4.5",
    "@shopify/mini-oxygen": "^4.2.2",
    "headroom-ai": "^0.37.0",
    "isbot": "^5.1.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "~7.16.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
    "@react-router/dev": "~7.16.0",
    "@react-router/fs-routes": "~7.16.0",
    "@shopify/cli": "^3.84.2",
    "@shopify/hydrogen-codegen": "^0.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
