{
  "name": "assam-tea-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run typegen && shopify hydrogen dev",
    "dev:local": "vite --host 0.0.0.0",
    "build": "npm run typegen && react-router build",
    "start": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --import ./tests/support/windows-userinfo.mjs --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test --project=storefront",
    "test:e2e:account": "playwright test --project=account",
    "format:check": "prettier --check \"tests/**/*.{ts,tsx}\" \"playwright.config.ts\" \"vite.e2e.config.ts\" \"eslint.config.js\"",
    "lint": "eslint app tests playwright.config.ts vite.e2e.config.ts",
    "typegen": "react-router typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "deploy:oxygen": "npm run typegen && shopify hydrogen deploy",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@shopify/hydrogen": "^2026.4.5",
    "@shopify/mini-oxygen": "^4.2.2",
    "headroom-ai": "^0.37.0",
    "htmlparser2": "^10.1.0",
    "isbot": "^5.1.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "~7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^7.4.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "~7.16.0",
    "@react-router/fs-routes": "~7.16.0",
    "@shopify/cli": "^3.84.2",
    "@shopify/hydrogen-codegen": "^0.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.9.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
